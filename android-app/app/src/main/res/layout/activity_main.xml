<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B0C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#A1A1A8"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/layoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="layout"
            android:textColor="#EDEDED"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip" />

        <TextView
            android:id="@+id/scanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="scan"
            android:textColor="#EDEDED"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip" />

        <TextView
            android:id="@+id/expandButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="expand"
            android:textColor="#EDEDED"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_chip" />

    </LinearLayout>

    <!-- The typing bar: shows what is really in the text box focused on the desktop, with
         a caret and a line under it like an Android text field. Hidden when no box is focused. -->
    <LinearLayout
        android:id="@+id/typingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#141416"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/typingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8A8A92"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/typingPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EDEDED"
            android:textSize="18sp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:maxLines="2"
            android:ellipsize="start" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:alpha="0.55"
            android:background="#EDEDED" />
    </LinearLayout>

    <com.remotehid.server.input.TrackpadView
        android:id="@+id/trackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B0B0C" />

    <androidx.camera.view.PreviewView
        android:id="@+id/qrPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <com.remotehid.server.input.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
